# Database. Leave empty for local SQLite (geomacro.db). On Render/Neon paste the Postgres URL.
DATABASE_URL=
# Telegram alerts (BotFather token + your chat id; run scripts/telegram_chat_id.py to find the id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Free AIS key from https://aisstream.io (enables the tanker / AIS anomaly signal)
AISSTREAM_API_KEY=
# Optional alert wording by an LLM: gemini | openai | anthropic | groq | none
LLM_PROVIDER=none
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a self-hosted ShadowBroker backend (adds its GPS jamming layer as an extra feed)
SHADOWBROKER_API_BASE=
# Optional: protects POST endpoints (send header X-Admin-Token)
ADMIN_TOKEN=

# Login password for the dashboard and the Settings page (leave empty only for local testing)
ADMIN_PASSWORD=

# Runtime (spec section 22)
APP_ENV=production
LOG_LEVEL=INFO
# Note: the spec's CRUDE_FEED_API_KEY / MARKET_FEED_API_KEY are not needed. Crude (CL=F, BZ=F) and India VIX come
# from keyless public Yahoo Finance / NSE endpoints.
